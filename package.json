{
  "name": "medi-xplorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "tsx --test $(find src -name '*.test.ts' -type f)",
    "test:watch": "tsx --test --watch $(find src -name '*.test.ts' -type f)",
    "generate-master-versions": "chmod +x ./scripts/generate-versions.sh && ./scripts/generate-versions.sh",
    "generate-master-data": "pnpm exec tsx scripts/generate-master-data.ts",
    "build:masters": "pnpm generate-master-data && pnpm generate-master-versions",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "analyze": "ANALYZE=true pnpm build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-select": "^5.10.2",
    "rich-textarea": "^0.28.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-string": "^4.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.74.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "optionalDependencies": {
    "@oxfmt/binding-darwin-arm64": "0.74.0",
    "@oxfmt/binding-linux-x64-gnu": "0.74.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "packageManager": "pnpm@12.15.0"
}
